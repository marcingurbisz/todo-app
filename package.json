{
  "name": "todo-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "node ./tools/build-android.mjs",
    "android:install": "node ./tools/build-android.mjs --install",
    "android:open": "npx cap open android",
    "preview": "vite preview",
    "test": "vitest run",
    "test:live": "node ./tools/run-all-live-tests.mjs",
    "test:live:api": "node ./tools/run-live-api-test.mjs",
    "test:live:ui": "node ./tools/run-live-ui-test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "marked": "^16.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@playwright/test": "^1.54.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
